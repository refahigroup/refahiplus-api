    "PaymentExecution": {
      "RecoveryPollSeconds": 30,
      "AutoResumePollSeconds": 15,
      "RecoveryBatchSize": 50,
      "ProcessingLeaseSeconds": 120,
      "BaseRetrySeconds": 30,
      "MaximumRetrySeconds": 900
