      "place": {
        "type": "places",
        "id": "01ktm91af6e7tq01b2w3z5tgcq",
        "attributes": {
          "title": "پردیس سینمایی شمیران",
          "slug": "پردیس-سینمایی-شمیران",
          "description": "<p>سینما شمیران سنتر در تیرماه 1399 در شمال شرق تهران و در محله اقدسیه به بهره‌برداری رسید. سینما شمیران سنتر دارای 5 سالن است که شامل سالن قرمز با 154 صندلی، سالن نارنجی با 92 صندلی، سالن آبی با 49 صندلی، سالن سبز با 38 صندلی و سالن VIP با ظرفیت 36 صندلی می‌باشد. تمامی سالن‌های سینما شمیران سنتر به سیستم‌های پخش پیشرفته و صوت دالبی مجهز هستند و طراحی آن‌ها به گونه‌ای است که دسترسی معلولان جسمی-حرکتی را تسهیل می‌کند. به دلیل ازدحام پارکینگ در روزهای پنجشنبه و جمعه، پیشنهاد می‌شود که 30 دقیقه زودتر به سینما شمیران سنتر مراجعه کنید.</p><p><br></p>",
          "display_priority": 462,
          "province_id": 8,
          "province_name": "تهران",
          "city_id": 119,
          "city_name": "تهران",
          "address": "اقدسیه - بزرگراه ارتش- مجموعه شمیران سنتر- طبقه 3",
